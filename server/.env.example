# For local development: copy to ".env" (it is read by "npm run dev"). Start the database first:
#   npm run db:dev        (from the repository root)
DATABASE_URL=postgres://qras:qras@localhost:55432/qras
PORT=3000
# The Vite dev server (npm run dev:web) talks to this API from another port.
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
