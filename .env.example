# Copy this file to ".env" and adjust it. Never commit the real ".env".

# Password of the database (required). Use a long random value.
POSTGRES_PASSWORD=change-me

# Port where the app listens on this machine.
APP_PORT=3000

# The public address of the installation, used in the invitation and password links.
# Leave empty to use the address the browser used.
PUBLIC_URL=

# --- HTTPS with Caddy (docker compose --profile https up -d) ---
# DOMAIN=attendance.example.com
# TRUST_PROXY=true
# COOKIE_SECURE=true

# --- Email (optional) ---
# Without it everything works: invitation and password links are shown on screen to copy.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM="QR Attendance <no-reply@example.com>"

LOG_LEVEL=info
